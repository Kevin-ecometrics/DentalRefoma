---
import Layout from "@/layouts/Layout.astro";
import { fade } from "astro:transitions";
import VCardButton from "@/components/doctors/VCardButton";
export async function getStaticPaths() {
  const doctores = [
    {
      id: "DraKaren",
      nombre: "Dra. Karen Haylin Pérez Álvarez",
      imagen: "/images/drkarenperfil.webp",
      titulo: "Ortodoncista",
      experiencia: "12 años de experiencia",
      formacion: "Universidad Autónoma de Baja California Valle de las Palmas",
      cedula: "9964413",
      cedula2: "12255010",
      url: "karen-haylin-perez-alvarez",
      especialistaES: "Universidad Autónoma de Baja California Otay",
      horario: "Lunes a Viernes: 9:00 - 18:00",
      bio: "Especialista en endodoncia con más de 10 años de experiencia transformando sonrisas. Miembro activo de la Asociación Dental Mexicana y pionera en técnicas de ortodoncia invisible.",
      especialidades: [
        "Ortodoncia Invisible",
        "Brackets Estéticos",
        "Ortodoncia Infantil",
      ],
      certificaciones: [
        "Certificación en Ortodoncia Invisible",
        "Miembro de la Asociación Dental Mexicana",
      ],
    },
    {
      id: "DraLizeth",
      nombre: "Lizeth Rocha Campos",
      imagen: "/images/lizethperfil.webp",
      titulo: "Cirujana Dentista",
      experiencia: "2 años de experiencia",
      cedula: "14864659",
      url: "lizeth-rocha-campos",
      formacion: "Universidad Autónoma de Baja California Valle de las Palmas",
      horario: "Lunes a Jueves: 8:00 - 17:00",
      bio: "Cirujana dentista con experiencia en tratamientos de ortodoncia y estética dental. Comprometida con la salud bucal y el bienestar de sus pacientes.",
      especialidades: ["Estética", "Odontología General"],
    },
    {
      id: "DraItzel",
      nombre: "Dra. Alejandra Yazmin Gonzalez Amezquita",
      imagen: "/images/alejandraperfil.webp",
      titulo: "Cirujana Dentista",
      cedula: "12030675",
      url: "alejandra-yazmin-gonzalez-amezquita",
      especialista: "especialista en ortodoncia",
      formacionES: "INODET",
      experiencia: "4 años de experiencia",
      formacion: "Universidad Autónoma de Baja California Otay",
      horario: "Miércoles a Domingo: 11:00 - 20:00",
      bio: "Especialista en tratamientos de conductos con tecnología de vanguardia. Enfoque en procedimientos mínimamente invasivos para mayor comodidad del paciente.",
      especialidades: [
        "Tratamiento de Conductos",
        "Retratamientos",
        "Endo Postes",
      ],
      certificaciones: [
        "Certificación en Endodoncia Avanzada",
        "Miembro de la AAE",
      ],
    },
    {
      id: "DraCarolina",
      nombre: "Dra. Carolina Isabel Morales Vázquez",
      imagen: "/images/carolinaperfil.webp",
      titulo: "Periodoncista",

      url: "carolina-isabel-morales-vazquez",
      especialista: "especialista en periodoncia",
      formacionES: "Universidad de Guadalajara",
      experiencia: "7 años de experiencia",
      formacion: "Universidad Autónoma de Baja California Otay",
      horario: "Martes a Sábado: 10:00 - 19:00",
      bio: "Especialista en periodoncia y cirugía de encías con enfoque en tratamientos regenerativos. Certificada en técnicas láser para el tratamiento de enfermedades periodontales y estética gingival.",
      especialidades: [
        "Periodoncia",
        "Cirugía de Encías",
        "Tratamientos Láser",
      ],
      certificaciones: [
        "Certificación en Periodoncia Avanzada",
        "Miembro de la Sociedad Mexicana de Periodoncia",
      ],
    },
  ];

  return doctores.map((doctor) => ({
    params: { id: doctor.url },
    props: { doctor },
  }));
}

const { doctor } = Astro.props;

const allDoctors = [
  "karen-haylin-perez-alvarez",
  "lizeth-rocha-campos",
  "alejandra-yazmin-gonzalez-amezquita",
  "carolina-isabel-morales-vazquez",
];

const currentIndex = allDoctors.indexOf(doctor.url);
const prevIndex = (currentIndex - 1 + allDoctors.length) % allDoctors.length;
const nextIndex = (currentIndex + 1) % allDoctors.length;
const prevDoctorId = allDoctors[prevIndex];
const nextDoctorId = allDoctors[nextIndex];
---

<Layout title={"Dentista | " + doctor.nombre} description={doctor.bio}>
  <div
    transition:animate={fade({ duration: "0.4s" })}
    class="max-w-screen-xl mx-auto p-6"
  >
    <div
      class="bg-white rounded-lg shadow-lg overflow-hidden grid grid-cols-1 lg:grid-cols-2"
    >
      <div class="relative min-h-[400px] lg:min-h-[600px]">
        <img
          src={doctor.imagen}
          alt={doctor.nombre}
          class="w-full h-full object-cover"
        />
        <div
          class="absolute top-8 left-8 bg-reforma text-white px-4 py-2 rounded-full font-semibold text-lg"
        >
          {doctor.titulo}
        </div>
      </div>

      <div class="p-8">
        <div class="mb-10">
          <h1 class="text-4xl font-bold text-gray-800 mb-2">{doctor.nombre}</h1>
          <p class="text-reforma text-2xl font-semibold mb-6">
            {doctor.experiencia}
          </p>
          <div class="md:flex gap-8 items-center">
            {
              doctor.cedula && (
                <p class="text-lg font-semibold mb-2">
                  <strong class="text-reforma">Cédula Profesional:</strong>
                  <span class="text-black"> {doctor.cedula}</span>
                </p>
              )
            }
            {
              doctor.cedula2 && (
                <p class="text-lg font-semibold mb-2">
                  <strong class="text-reforma">Cédula Especialidad:</strong>
                  <span class="text-black"> {doctor.cedula2}</span>
                </p>
              )
            }
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
          <div class="flex items-start gap-4">
            <div class="text-reforma">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path
                  d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-800 mb-1">
                Formación Académica
              </h3>
              <p class="text-gray-600">{doctor.formacion}</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="text-reforma">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-800 mb-1">
                Horario de Atención
              </h3>
              <p class="text-gray-600">{doctor.horario}</p>
            </div>
          </div>

          {
            doctor.certificaciones && (
              <div class="flex items-start gap-4 md:col-span-2">
                <div class="text-reforma">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 2L2 7l10 5 10-5-10-5z" />
                    <path d="M2 17l10 5 10-5" />
                    <path d="M2 12l10 5 10-5" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-800 mb-1">
                    Certificaciones (Endodoncia)
                  </h3>

                  <p class="text-gray-600">{doctor.certificaciones}</p>
                </div>
              </div>
            )
          }
        </div>

        <h2 class="text-2xl font-bold text-gray-800 mb-4">
          Biografía Profesional
        </h2>
        <p class="text-gray-600 mb-12">{doctor.bio}</p>

        <div>
          <h2 class="text-2xl font-bold text-gray-800 mb-4">Especialidades</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
              doctor.especialidades.map((especialidad, index) => (
                <div
                  class={
                    `bg-reforma/20 p-4 rounded-lg flex items-center gap-4` +
                    (doctor.especialidades.length === 3 && index === 2
                      ? " md:col-span-2"
                      : "")
                  }
                >
                  <div class="w-10 h-10 bg-reforma text-white flex items-center justify-center rounded-full">
                    {index + 1}
                  </div>
                  <div class="font-semibold text-gray-800">{especialidad}</div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-12 mb-6 cursor-pointer">
          <VCardButton
            client:only="react"
            nombre={doctor.nombre}
            titulo={doctor.titulo}
            telefono="6631995492"
            email="pacientes@dentistareforma.com"
            sitioWeb="https://dentistareforma.com"
            direccion="Av. Paseo Reforma 5304, La Esperanza, 22186 Tijuana, B.C."
            notaAdicional={`Especialista en ${doctor.especialidades[0]}`}
            imagenUrl={doctor.imagen}
          />
        </div>

        <div class="flex justify-between items-center mt-12 gap-4">
          <a
            href={`/doctores/${prevDoctorId}`}
            class="flex items-center gap-2 px-6 py-3 bg-reforma text-white rounded-full font-semibold hover:bg-reforma-hover transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Anterior
          </a>

          <a
            href="/#doctores"
            class="px-6 py-3 bg-reforma text-white rounded-full font-semibold hover:bg-reforma-hover transition"
          >
            Volver al Equipo
          </a>

          <a
            href={`/doctores/${nextDoctorId}`}
            class="flex items-center gap-2 px-6 py-3 bg-reforma text-white rounded-full font-semibold hover:bg-reforma-hover transition"
          >
            Siguiente
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
