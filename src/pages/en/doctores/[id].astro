---
import Layout from "@/layouts/Layout.astro";
import { fade } from "astro:transitions";
import VCardButton from "@/components/doctors/VCardButton";

export async function getStaticPaths() {
  const doctors = [
    {
      id: "DraKaren",
      name: "Dr. Karen Haylin Pérez Álvarez",
      image: "/images/drkarenperfil.webp",
      title: "Orthodontist",
      experience: "12 years of experience",
      education: "Autonomous University of Baja California Valle de las Palmas",
      license: "9964413",
      url: "karen-haylin-perez-alvarez",

      specialtyLicense: "12255010",
      specialtyEducation: "Autonomous University of Baja California Otay",
      schedule: "Monday to Friday: 9:00 AM - 6:00 PM",
      bio: "Specialist in endodontics with over 10 years of experience transforming smiles. Active member of the Mexican Dental Association and pioneer in invisible orthodontics techniques.",
      specialties: [
        "Invisible Orthodontics",
        "Aesthetic Braces",
        "Pediatric Orthodontics",
      ],
      certifications: [
        "Certification in Invisible Orthodontics",
        "Member of the Mexican Dental Association",
      ],
    },
    {
      id: "DraLizeth",
      name: "Lizeth Rocha Campos",
      image: "/images/lizethperfil.webp",
      title: "Dental Surgeon",
      url: "lizeth-rocha-campos",
      experience: "2 years of experience",
      license: "14864659",
      education: "Autonomous University of Baja California Valle de las Palmas",
      schedule: "Monday to Thursday: 8:00 AM - 5:00 PM",
      bio: "Dental surgeon with experience in orthodontic and aesthetic dental treatments. Committed to oral health and patient well-being.",
      specialties: ["Aesthetics", "General Dentistry"],
    },
    {
      id: "DraItzel",
      name: "Dr. Alejandra Yazmin Gonzalez Amezquita",
      image: "/images/alejandraperfil.webp",
      title: "Dental Surgeon",
      license: "12030675",
      url: "alejandra-yazmin-gonzalez-amezquita",

      specialty: "Orthodontics Specialist",
      specialtyEducation: "INODET",
      experience: "4 years of experience",
      education: "Autonomous University of Baja California Otay",
      schedule: "Wednesday to Sunday: 11:00 AM - 8:00 PM",
      bio: "Specialist in root canal treatments with cutting-edge technology. Focused on minimally invasive procedures for greater patient comfort.",
      specialties: ["Root Canal Treatment", "Retreatments", "Endo Posts"],
      certifications: [
        "Advanced Endodontics Certification",
        "Member of the AAE",
      ],
    },
    {
      id: "DraCarolina",
      name: "Dr. Carolina Isabel Morales Vázquez",
      image: "/images/carolinaperfil.webp",
      title: "Periodontist",
      url: "carolina-isabel-morales-vazquez",
      specialty: "Periodontics Specialist",
      specialtyEducation: "University of Guadalajara",
      experience: "7 years of experience",
      education: "Autonomous University of Baja California Otay",
      schedule: "Tuesday to Saturday: 10:00 AM - 7:00 PM",
      bio: "Specialist in periodontics and gum surgery with a focus on regenerative treatments. Certified in laser techniques for periodontal disease treatment and gingival aesthetics.",
      specialties: ["Periodontics", "Gum Surgery", "Laser Treatments"],
      certifications: [
        "Advanced Periodontics Certification",
        "Member of the Mexican Society of Periodontics",
      ],
    },
  ];

  return doctors.map((doctor) => ({
    params: { id: doctor.url },
    props: { doctor },
  }));
}

const { doctor } = Astro.props;

const allDoctors = [
  "karen-haylin-perez-alvarez",
  "lizeth-rocha-campos",
  "alejandra-yazmin-gonzalez-amezquita",
  "carolina-isabel-morales-vazquez",
];

const currentIndex = allDoctors.indexOf(doctor.url);
const prevIndex = (currentIndex - 1 + allDoctors.length) % allDoctors.length;
const nextIndex = (currentIndex + 1) % allDoctors.length;
const prevDoctorId = allDoctors[prevIndex];
const nextDoctorId = allDoctors[nextIndex];
---

<Layout
  transition:animate={fade({ duration: "0.4s" })}
  title={"Dentist | " + doctor.name}
  description={doctor.bio}
>
  <div class="max-w-screen-xl mx-auto p-6">
    <div
      class="bg-white rounded-lg shadow-lg overflow-hidden grid grid-cols-1 lg:grid-cols-2"
    >
      <div class="relative min-h-[400px] lg:min-h-[600px]">
        <img
          src={doctor.image}
          alt={doctor.name}
          class="w-full h-full object-cover"
        />
        <div
          class="absolute top-8 left-8 bg-reforma text-white px-4 py-2 rounded-full font-semibold text-lg"
        >
          {doctor.title}
        </div>
      </div>

      <div class="p-8">
        <div class="mb-10">
          <h1 class="text-4xl font-bold text-gray-800 mb-2">{doctor.name}</h1>
          <p class="text-reforma text-2xl font-semibold mb-6">
            {doctor.experience}
          </p>
          <div class="md:flex gap-8 items-center">
            {
              doctor.license && (
                <p class="text-lg font-semibold mb-2">
                  <strong class="text-reforma">Professional License:</strong>
                  <span class="text-black"> {doctor.license}</span>
                </p>
              )
            }
            {
              doctor.specialtyLicense && (
                <p class="text-lg font-semibold mb-2">
                  <strong class="text-reforma">Specialty License:</strong>
                  <span class="text-black"> {doctor.specialtyLicense}</span>
                </p>
              )
            }
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
          <div class="flex items-start gap-4">
            <div class="text-reforma">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path
                  d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-800 mb-1">
                Academic Background
              </h3>
              <p class="text-gray-600">{doctor.education}</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="text-reforma">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-800 mb-1">
                Office Hours
              </h3>
              <p class="text-gray-600">{doctor.schedule}</p>
            </div>
          </div>

          {
            doctor.certifications && (
              <div class="flex items-start gap-4 md:col-span-2">
                <div class="text-reforma">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 2L2 7l10 5 10-5-10-5z" />
                    <path d="M2 17l10 5 10-5" />
                    <path d="M2 12l10 5 10-5" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-800 mb-1">
                    Certifications (Endodontics)
                  </h3>
                  <p class="text-gray-600">{doctor.certifications}</p>
                </div>
              </div>
            )
          }
        </div>
        <h2 class="text-2xl font-bold text-gray-800 mb-4">
          Professional Biography
        </h2>
        <p class="text-gray-600 mb-12">{doctor.bio}</p>

        <div>
          <h2 class="text-2xl font-bold text-gray-800 mb-4">Specialties</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
              doctor.specialties.map((specialty, index) => (
                <div
                  class={
                    `bg-reforma/20 p-4 rounded-lg flex items-center gap-4` +
                    (doctor.specialties.length === 3 && index === 2
                      ? " md:col-span-2"
                      : "")
                  }
                >
                  <div class="w-10 h-10 bg-reforma text-white flex items-center justify-center rounded-full">
                    {index + 1}
                  </div>
                  <div class="font-semibold text-gray-800">{specialty}</div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mt-12 mb-6 cursor-pointer">
          <VCardButton
            client:load
            nombre={doctor.name}
            titulo={doctor.title}
            telefono="6631995492"
            email="pacientes@dentistareforma.com"
            sitioWeb="https://dentistareforma.com"
            direccion="Av. Paseo Reforma 5304, La Esperanza, 22186 Tijuana, B.C."
            notaAdicional={`Especialista en ${doctor.specialties[0]}`}
            imagenUrl={doctor.image}
          />
        </div>

        <div class="flex justify-between items-center mt-12 gap-4">
          <a
            href={`/en/doctores/${prevDoctorId}/`}
            class="flex items-center gap-2 px-6 py-3 bg-reforma text-white rounded-full font-semibold hover:bg-reforma-hover transition"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Previous
          </a>

          <a
            href="/en/#doctores"
            class="px-6 py-3 bg-reforma text-white rounded-full font-semibold hover:bg-reforma-hover transition"
          >
            Back to Team
          </a>

          <a
            href={`/en/doctores/${nextDoctorId}/`}
            class="flex items-center gap-2 px-6 py-3 bg-reforma text-white rounded-full font-semibold hover:bg-reforma-hover transition"
          >
            Next
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
