---
import Layout from "@layouts/Layout.astro";
import Header from "@/components/Header";
import Hero from "@components/Hero.astro";
import Mision from "@components/Mision.astro";
import Instalaciones from "@components/Instalaciones.astro";
import Services from "@/components/Services";
import Carrousel from "@components/Carrousel";
import Footer from "@components/Footer.astro";
import Agenda from "@components/Agenda";
import Social from "@components/Social.astro";
import Mapa from "@components/Mapa.astro";
import Doctores from "@/components/Doctores.astro";
---

<Layout
  title="Clinica Dental Reforma Tijuana"
  description="En Clinica Reforma Tijuana llevamos 35 años brindando soluciones odontológicas integrales con profesionalismo y calidez. Nuestro equipo certificado se especializa en alivio inmediato del dolor dental."
>
  <Header client:only="react" />
  <Hero />
  <Mision />
  <Instalaciones />
  <Carrousel client:visible />
  <Services client:visible />
  <Doctores />
  <Agenda client:only="react" />
  <Social />
  <Mapa />
  <Footer />
</Layout>
