---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import Mision from "@components/Mision.astro";
import Instalaciones from "@components/Instalaciones.astro";
import Services from "@/components/Services";
import Carrousel from "@components/Carrousel";
import Footer from "@components/Footer.astro";
import Agenda from "@components/Agenda";
import Social from "@components/Social.astro";
import Mapa from "@components/Mapa.astro";
import Doctores from "@/components/Doctores.astro";
import { fade } from "astro:transitions";
---

<Layout
  title="Clínica Dental Reforma - Expertos en Odontología"
  description="En Clínica Dental Reforma Tijuana contamos con más de 35 años de experiencia ofreciendo soluciones odontológicas integrales, con un equipo certificado y atención profesional para cuidar tu salud dental."
>
  <div transition:animate={fade({ duration: "0.4s" })}>
    <Hero />
    <Mision />
    <Instalaciones />
    <Carrousel client:visible />
    <Services client:visible />
    <Doctores />
    <Agenda client:only="react" />
    <Social />
    <Mapa />
    <Footer />
  </div>
</Layout>
