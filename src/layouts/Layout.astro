---
import "@styles/global.css";
import "@fontsource-variable/archivo-narrow";
import "@fontsource-variable/roboto";
import "@fontsource-variable/josefin-sans";
import Whatsapp from "@/components/Menu";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang = Astro.url.pathname.startsWith("/en/") ? "en" : "es";
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{lang === "es" ? "Dental Reforma - Clínica Dental en Tijuana" : "Dental Reforma - Dental Clinic in Tijuana"}</title>
    <meta
      name="description"
      content={lang === "es" 
        ? "En Dental Reforma Tijuana llevamos 35 años brindando soluciones odontológicas integrales con profesionalismo, calidez y confianza." 
        : "At Dental Reforma Tijuana, we have been providing comprehensive dental solutions with professionalism and warmth for 35 years."}
    />

    <meta name="robots" content="index, follow" />
    <meta
      name="keywords"
      content={lang === "es" 
        ? "Endodoncia, Ortodoncia, Implantes Dentales, Cirugía Oral, Prótesis Dentales, Coronas, Resinas, Periodoncia, Odontopediatría"
        : "Endodontics, Orthodontics, Dental Implants, Oral Surgery, Dental Prosthetics, Crowns, Resins, Periodontics, Pediatric Dentistry"}
    />
    <meta name="author" content="Dentista Reforma" />
    <meta name="geo.region" content="MX-BC" />
    <meta name="geo.placename" content="Tijuana" />

    <meta property="og:title" content={`${title} | Dentista Reforma`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta
      property="og:image"
      content="https://www.dentistareforma.com/images/clinica-reforma-og.jpg"
    />
    <meta property="og:site_name" content="Dentista Reforma" />
    <meta property="og:locale" content={lang === "es" ? "es_MX" : "en_US"} />

    <link rel="icon" href="/favicon.ico"/>
    <link rel="canonical" href={Astro.url.href} />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "DentalClinic",
        "name": "Dental Reforma",
          "publisher": {
            "@type": "Organization",
            "name": "Ecommetrica",
            "url": "https://ecommetrica.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://www.dentistareforma.com/images/logo-dental-reforma.png",
            "width": 300,
            "height": 100
          }
        },
        "description": {
          "@language": "es",
          "@value": "En Dental Reforma Tijuana llevamos 35 años brindando soluciones odontológicas integrales con profesionalismo y calidez. Nuestro equipo certificado se especializa en alivio inmediato del dolor dental, tratamiento de emergencias e infecciones, implantes dentales y prótesis, ortodoncia (brackets e Invisalign), así como estética dental y blanqueamiento."
        },
        "inLanguage": {
          "@language": "es",
          "@value": "Spanish"
        },
        "url": "https://www.dentistareforma.com/",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. Paseo Reforma 5304",
          "addressLocality": "Tijuana",
          "addressRegion": "BC",
          "postalCode": "22000",
          "addressCountry": "MX"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "32.5149",
          "longitude": "-117.0382"
        },
        "telephone": "+52 (664) 535-8869",
        "email": "dentistareforma@gmail.com",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday"
            ],
            "opens": "09:00",
            "closes": "18:00"
          }
        ],
        "knowsLanguage": ["es", "en"],
        "paymentAccepted": {
          "@language": "es",
          "@value": "Efectivo, Tarjetas de crédito/débito, Transferencia bancaria"
        },
        "hasMap": "https://maps.app.goo.gl/PbhtibPh81px2pei8",
        "wheelchairAccessible": true,
        "priceRange": "$$",
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5",
          "reviewCount": "10",
          "bestRating": "5",
          "worstRating": "1"
        },
        "review": [
          {
            "@type": "Review",
            "author": "Ramon Dávila",
            "datePublished": "2023-05-15",
            "reviewBody": "Muy buena atención 😃",
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5",
              "bestRating": "5"
            }
          }
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": {
            "@language": "es",
            "@value": "Servicios Dentales"
          },
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": {
                  "@language": "es",
                  "@value": "Endodoncia"
                }
              }
            }
          ]
        },
        "sameAs": [
          "https://www.facebook.com/DentistaReforma",
          "https://www.instagram.com/dentistareforma/",
          "https://api.whatsapp.com/send/?phone=526645358869&text&type=phone_number&app_absent=0"
        ]
      }
    </script>

    {lang === "en" && (
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "DentalClinic",
          "name": "Dental Reforma",
          "publisher": {
            "@type": "Organization",
            "name": "Dental Reforma",
            "url": "https://www.dentistareforma.com/en/",
            "logo": {
              "@type": "ImageObject",
              "url": "https://www.dentistareforma.com/images/logo-dental-reforma.png",
              "width": 300,
              "height": 100
            }
          },
          "description": "At Dental Reforma Tijuana, we have been providing comprehensive dental solutions with professionalism and warmth for 35 years. Our certified team specializes in immediate relief of dental pain, emergency treatments and infections, dental implants and prosthetics, orthodontics (braces and Invisalign), as well as dental aesthetics and whitening.",
          "inLanguage": "en",
          "url": "https://www.dentistareforma.com/en/",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Av. Paseo Reforma 5304",
            "addressLocality": "Tijuana",
            "addressRegion": "BC",
            "postalCode": "22000",
            "addressCountry": "MX"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": "32.5149",
            "longitude": "-117.0382"
          },
          "telephone": "+52 (664) 535-8869",
          "email": "dentistareforma@gmail.com",
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday"
              ],
              "opens": "09:00",
              "closes": "18:00"
            }
          ],
          "paymentAccepted": "Cash, Credit/Debit Cards, Bank Transfer",
          "hasMap": "https://maps.app.goo.gl/PbhtibPh81px2pei8",
          "wheelchairAccessible": true,
          "priceRange": "$$",
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "5",
            "reviewCount": "10",
            "bestRating": "5",
            "worstRating": "1"
          },
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Dental Services",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": {
                  "@type": "Service",
                  "name": "Endodontics"
                }
              }
            ]
          }
        }
      </script>
    )}
  </head>

  <body>
    <slot />
    <Whatsapp client:load />
  </body>
</html>


<style is:global>
  html {
    scroll-behavior: smooth;
  }
  p,
  span,
  a,
  li {
    font-family: "Josefin Sans Variable", sans-serif;
    font-size: 16px;
  }
  @font-face {
    font-family: "Rockwell Nova";
    src: url("/fonts/RockwellNova-Bold.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  h1 {
    font-family: "Rockwell Nova", serif;
    font-weight: 700; /* Coincide con el peso definido en @font-face */
  }
  @font-face {
    font-family: "Gisbon";
    src: url("/fonts/fonnts.com-Gibson_SemiBold.otf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  h2 {
    font-family: "Gisbon", serif;
    font-weight: 700; /* Coincide con el peso definido en @font-face */
  }
  @font-face {
    font-family: "ITC Avant Garde Gothic LT Medium";
    src: url("/fonts/ITCAvantGardeGothicLTMedium.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
    font-size: 16px;
  }
  h3 {
    font-family: "ITC Avant Garde Gothic LT Medium", serif;
    font-weight: 700;
    font-size: 16px;
  }
  .description-text {
    font-family: "ITC Avant Garde Gothic LT Medium", serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5;
  }
</style>