---
import { FaFacebook, FaInstagram, FaWhatsapp } from "react-icons/fa";
const YEAR = new Date().getFullYear();

const isEnglish = Astro.url.pathname.startsWith("/en/");
---

<footer
  class="bg-gradient-to-br from-white to-[#f8fcec] text-[#545758] py-16 relative overflow-hidden"
>
  <div
    class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-[#00c9a7] via-[#845ec2] via-[#d65db1] via-[#ff6f91] via-[#ff9671] via-[#ffc75f] to-[#f9f871] animate-[gradientFlow_8s_ease_infinite]"
  >
  </div>
  <div
    class="max-w-screen-xl mx-auto px-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 relative"
  >
    <div class="flex flex-col items-start">
      <figure>
        <img
          title={isEnglish ? "Dentist Reforma" : "Dentista Reforma"}
          src="/images/logofooter.webp"
          alt={isEnglish ? "Dentist Reforma" : "Dentista Reforma"}
          class="size-32 mb-6 drop-shadow-md"
        />
      </figure>

      <p class="text-[#4f646f] text-base leading-relaxed max-w-xs mb-6">
        {
          isEnglish
            ? "Transforming smiles with cutting-edge technology and compassionate care."
            : "Transformando sonrisas con tecnología de vanguardia y cuidado compasivo."
        }
      </p>
      <div class="flex gap-4">
        <a
          title="Facebook"
          href="https://www.facebook.com/dentistareforma"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-500 hover:text-[#aed136] transition-colors duration-300"
          aria-label="Facebook"
        >
          <FaFacebook size={24} />
        </a>
        <a
          title="Instagram"
          href="https://www.instagram.com/dentistareforma/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-500 hover:text-[#aed136] transition-colors duration-300"
          aria-label="Instagram"
        >
          <FaInstagram size={24} />
        </a>
        <a
          title="WhatsApp"
          href="https://wa.me/525512345678"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-500 hover:text-[#aed136] transition-colors duration-300"
          aria-label="WhatsApp"
        >
          <FaWhatsapp size={24} />
        </a>
      </div>
    </div>

    <div>
      <h3
        class="text-lg font-bold mb-6 relative inline-block after:content-[''] after:absolute after:bottom-[-8px] after:left-0 after:w-12 after:h-[3px] after:bg-reforma after:rounded"
      >
      </h3>
      <ul class="space-y-4">
        <li>
          <a
            title={isEnglish ? "Phone" : "Teléfono"}
            href="tel:+525512345678"
            aria-label={isEnglish ? "Phone" : "Teléfono"}
            class="text-[#4f646f] hover:text-[#aed136] flex items-center gap-2 transition-transform duration-300 hover:translate-x-1"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="w-4 h-4 fill-current"
            >
              <path
                d="M6.62 10.79C8.06 13.62 10.38 15.94 13.21 17.38L15.41 15.18C15.69 14.9 16.08 14.82 16.43 14.93C17.55 15.3 18.75 15.5 20 15.5C20.55 15.5 21 15.95 21 16.5V20C21 20.55 20.55 21 20 21C10.61 21 3 13.39 3 4C3 3.45 3.45 3 4 3H7.5C8.05 3 8.5 3.45 8.5 4C8.5 5.25 8.7 6.45 9.07 7.57C9.18 7.92 9.1 8.31 8.82 8.59L6.62 10.79Z"
              ></path>
            </svg>
            +52 (664) 535-8869
          </a>
        </li>
        <li>
          <a
            title={isEnglish ? "Email" : "Correo electrónico"}
            href="mailto:hola@dentistareforma.com"
            aria-label={isEnglish ? "Email" : "Correo electrónico"}
            class="text-[#4f646f] hover:text-[#aed136] flex items-center gap-2 transition-transform duration-300 hover:translate-x-1"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="w-4 h-4 fill-current"
            >
              <path
                d="M22 6C22 4.9 21.1 4 20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6M20 6L12 11L4 6H20M20 18H4V8L12 13L20 8V18Z"
              ></path>
            </svg>
            dentistareforma@gmail.com
          </a>
        </li>
        <li>
          <a
            title={isEnglish ? "Location" : "Ubicación"}
            href="https://www.google.com/maps/place/Av.+Paseo+Reforma+5304,+Reforma,+22186+Tijuana,+B.C./@32.4666711,-116.9577486,17z/data=!3m1!4b1!4m6!3m5!1s0x80d939b4f1c51c2d:0xd18d3ee346749f2c!8m2!3d32.4666711!4d-116.9551737!16s%2Fg%2F11c1z3c9_f?entry=ttu"
            aria-label={isEnglish ? "Location" : "Ubicación"}
            class="text-[#4f646f] hover:text-[#aed136] flex items-center gap-2 transition-transform duration-300 hover:translate-x-1"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="w-4 h-4 fill-current"
            >
              <path
                d="M12 11.5A2.5 2.5 0 0 1 9.5 9A2.5 2.5 0 0 1 12 6.5A2.5 2.5 0 0 1 14.5 9a2.5 2.5 0 0 1-2.5 2.5M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Z"
              ></path>
            </svg>
            Av. Paseo Reforma 5304, La Esperanza, 22186 Tijuana, B.C.
          </a>
        </li>
        <li>
          <a
            title={isEnglish ? "Schedule" : "Horario"}
            href="reserva"
            aria-label="Horario"
            class="text-[#4f646f] hover:text-[#aed136] flex items-center gap-2 transition-transform duration-300 hover:translate-x-1"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="w-4 h-4 fill-current"
            >
              <path
                d="M12 20C16.4 20 20 16.4 20 12S16.4 4 12 4 4 7.6 4 12 7.6 20 12 20M12 2C17.5 2 22 6.5 22 12S17.5 22 12 22C6.5 22 2 17.5 2 12C2 6.5 6.5 2 12 2M17 13.9L16.3 15.2L11 12.3V7H12.5V11.4L17 13.9Z"
              ></path>
            </svg>
            Lun-Sab: 9am - 6pm
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h3
        class="text-lg font-bold mb-6 relative inline-block after:content-[''] after:absolute after:bottom-[-8px] after:left-0 after:w-12 after:h-[3px] after:bg-reforma after:rounded"
      >
      </h3>
      <ul class="space-y-4">
        <li>
          <a
            title={isEnglish ? "Facilities" : "Instalaciones"}
            href="#instalaciones"
            aria-label={isEnglish ? "Facilities" : "Instalaciones"}
            class="text-[#4f646f] hover:text-[#aed136] flex items-center gap-2 transition-transform duration-300 hover:translate-x-1"
          >
            {isEnglish ? "Facilities" : "Instalaciones"}
          </a>
        </li>
        <li>
          <a
            title={isEnglish ? "Treatments" : "Tratamientos"}
            href="#tratamientos"
            aria-label={isEnglish ? "Treatments" : "Tratamientos"}
            class="text-[#4f646f] hover:text-[#aed136] flex items-center gap-2 transition-transform duration-300 hover:translate-x-1"
          >
            {isEnglish ? "Treatments" : "Tratamientos"}
          </a>
        </li>
        <li>
          <a
            title={isEnglish ? "Book" : "Reserva"}
            href="#reserva"
            aria-label={isEnglish ? "Book" : "Reserva"}
            class="text-[#4f646f] hover:text-[#aed136] flex items-center gap-2 transition-transform duration-300 hover:translate-x-1"
          >
            {isEnglish ? "Book" : "Reserva"}
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div
    class="text-center text-[#4f646f] text-sm mt-12 pt-8 border-t border-gray-200"
  >
    <p>
      &copy; {YEAR}
      {isEnglish ? "Dentist Reforma" : "Dentista Reforma"}.
      {isEnglish ? "All rights reserved." : "Todos los derechos reservados."}
    </p>
  </div>
</footer>
