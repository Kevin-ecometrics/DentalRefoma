---
const currentLang = Astro.url.pathname.startsWith("/en/") ? "en" : "es";

const instalaciones = {
  es: [
    {
      img: "/images/insta1.jpeg",
      alt: "Atención Personalizada",
      title: "Atención Personalizada",
      subtitle:
        "Queremos atenderte a tu tiempo y con espacio. Contamos con instalaciones y equipo de primer nivel.",
      features: [
        "Amplios sillones ergonómicos",
        "Espacios diseñados para tu comodidad",
      ],
    },
    {
      img: "/images/insta2.jpeg",
      alt: "Privacidad Garantizada",
      title: "Privacidad Garantizada",
      subtitle:
        "Espacios individuales y privados para tu tranquilidad durante cada tratamiento.",
      features: [
        "Cabinas completamente privadas",
        "Tecnología de última generación",
      ],
    },
  ],
  en: [
    {
      img: "/images/insta1.jpeg",
      alt: "Personalized Attention",
      title: "Personalized Attention",
      subtitle:
        "We aim to treat you on your schedule and with space. Our facilities and equipment are top-notch.",
      features: ["Wide ergonomic chairs", "Spaces designed for your comfort"],
    },
    {
      img: "/images/insta2.jpeg",
      alt: "Guaranteed Privacy",
      title: "Guaranteed Privacy",
      subtitle:
        "Private and individual rooms to ensure your peace of mind during every treatment.",
      features: ["Fully private cabins", "State-of-the-art technology"],
    },
  ],
};
---

<section id="instalaciones" class="container mx-auto px-5 py-16">
  <div>
    <h2 class="text-[#545758] text-4xl font-bold text-center mb-4">
      {currentLang === "es" ? "Nuestras Instalaciones" : "Our Facilities"}
    </h2>
    <p class="text-[#545758] text-xl text-center max-w-3xl mx-auto mb-16">
      {
        currentLang === "es"
          ? "Diseñadas para tu comodidad y seguridad"
          : "Designed for your comfort and safety"
      }
    </p>

    <!-- DESKTOP -->
    <div class="hidden md:flex flex-col gap-12 mb-8">
      {
        instalaciones[currentLang].map((instalacion, index) => (
          <div
            class={`flex min-h-[400px] relative rounded-xl overflow-hidden shadow-lg hover:shadow-xl hover:-translate-y-2.5 transition-all duration-300 ${index % 2 !== 0 ? "flex-row-reverse" : ""}`}
          >
            <div class="w-1/2 relative">
              <img
                title="Instalaciones Dentista Reforma"
                src={instalacion.img}
                alt={instalacion.title}
                class="w-full h-full object-cover transition-all duration-300 hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-br from-[rgba(156,193,21,0.3)] to-[rgba(156,193,21,0)]" />
              <div
                class={`absolute w-[200px] h-full top-0 ${index % 2 !== 0 ? "-left-[100px] skew-x-[-15deg]" : "-right-[100px] skew-x-[-15deg]"} bg-white z-10`}
              />
            </div>
            <div class="w-1/2 p-12 flex flex-col justify-center bg-white z-20">
              <h3 class="text-[#aed136] text-3xl font-semibold mb-5">
                {instalacion.title}
              </h3>
              <div class="w-[250px] h-[3px] bg-[#aed136] rounded mb-6" />
              <p class="text-[#545758] text-lg leading-relaxed mb-6">
                {instalacion.subtitle}
              </p>
              <ul class="list-none p-0 m-0">
                {instalacion.features.map((feature) => (
                  <li class="relative pl-6 mb-3 text-[#545758] before:content-['✓'] before:absolute before:left-0 before:text-[#aed136] before:font-bold">
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>

    <!-- MOBILE -->
    <div class="flex md:hidden flex-col gap-8 mb-8">
      {
        instalaciones[currentLang].map((instalacion, index) => (
          <div class="flex flex-col min-h-auto rounded-xl overflow-hidden shadow-lg">
            <div class="w-full">
              <img
                title="Instalaciones Dentista Reforma"
                src={instalacion.img}
                alt={instalacion.title}
                class="w-full h-auto"
              />
              <div class="absolute inset-0 bg-gradient-to-br from-[rgba(156,193,21,0.3)] to-[rgba(156,193,21,0)]" />
            </div>
            <div class="w-full p-5 bg-white">
              <h3 class="text-[#aed136] text-2xl font-semibold mb-4">
                {instalacion.title}
              </h3>
              <div class="w-[60px] h-[3px] bg-[#aed136] rounded mb-5" />
              <p class="text-[#545758] text-base leading-relaxed mb-5">
                {instalacion.subtitle}
              </p>
              <ul class="list-none p-0 m-0">
                {instalacion.features.map((feature) => (
                  <li class="relative pl-6 mb-2 text-[#545758] before:content-['✓'] before:absolute before:left-0 before:text-[#aed136] before:font-bold">
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>

    <div class="text-center mb-8">
      <a
        title={currentLang === "es" ? "Agendar Cita" : "Book Appointment"}
        href="#reserva"
        aria-label={currentLang === "es" ? "Agendar Cita" : "Book Appointment"}
        class="inline-flex items-center justify-center bg-[#aed136] text-white px-12 py-4 rounded-full text-lg font-semibold no-underline transition-all duration-300 shadow-lg hover:bg-[#4f646f] hover:text-white hover:-translate-y-1 hover:shadow-xl"
      >
        <span>
          {currentLang === "es" ? "Agendar Cita" : "Book Appointment"}
        </span>
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          stroke="currentColor"
          stroke-width="2"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="ml-2.5 transition-all duration-300 group-hover:translate-x-1"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
