---
// src/components/Doctores.astro

const isEnglish = Astro.url.pathname.startsWith("/en/");

const doctores_es = [
  {
    id: "DraKaren",
    nombre: "Dra. Karen Haylin Pérez Álvarez",
    imagen: "/images/drkaren.webp",
    titulo: "Ortodoncista",
    url: "karen-haylin-perez-alvarez",
    experiencia: "12 años de experiencia",
    formacion: "Universidad Autónoma de Baja California Valle de las Palmas",
    especialistaES: "Universidad Autónoma de Baja California Otay",
    horario: "Lunes a Viernes: 9:00 - 18:00",
    bio: "Especialista en ortodoncia con más de 10 años de experiencia transformando sonrisas. Miembro activo de la Asociación Dental Mexicana y pionera en técnicas de ortodoncia invisible.",
  },
  {
    id: "DraLizeth",
    nombre: "Lizeth Rocha Campos",
    imagen: "/images/lizeth.webp",
    titulo: "Cirujana Dentista",
    experiencia: "2 años de experiencia",
    cedula: "14864659",
    url: "lizeth-rocha-campos",
    formacion: "Universidad Autónoma de Baja California Valle de las Palmas",
    horario: "Lunes a Jueves: 8:00 - 17:00",
    bio: "Cirujana dentista con experiencia en tratamientos de ortodoncia y estética dental. Comprometida con la salud bucal y el bienestar de sus pacientes.",
  },
  {
    id: "DraItzel",
    nombre: "Dra. Alejandra Yazmin Gonzalez Amezquita",
    imagen: "/images/alejandra.webp",
    titulo: "Cirujana Dentista",
    cedula: "12030675",
    url: "alejandra-yazmin-gonzalez-amezquita",
    especialista: "especialista en ortodoncia",
    formacionES: "INODET",
    experiencia: "4 años de experiencia",
    formacion: "Universidad Autónoma de Baja California Otay",
    horario: "Miércoles a Domingo: 11:00 - 20:00",
    bio: "Especialista en tratamientos de conductos con tecnología de vanguardia. Enfoque en procedimientos mínimamente invasivos para mayor comodidad del paciente.",
  },
];

const doctores_en = [
  {
    id: "DraKaren",
    nombre: "Dr. Karen Haylin Pérez Álvarez",
    imagen: "/images/drkaren.webp",
    titulo: "Orthodontist",
    experiencia: "12 years of experience",
    url: "karen-haylin-perez-alvarez",
    formacion: "Autonomous University of Baja California Valle de las Palmas",
    especialistaES: "Autonomous University of Baja California Otay",
    horario: "Monday to Friday: 9:00 AM - 6:00 PM",
    bio: "Specialist in orthodontics with over 10 years of experience transforming smiles. Active member of the Mexican Dental Association and pioneer in invisible orthodontics techniques.",
  },
  {
    id: "DraLizeth",
    nombre: "Lizeth Rocha Campos",
    imagen: "/images/lizeth.webp",
    titulo: "Dental Surgeon",
    experiencia: "2 years of experience",
    cedula: "14864659",
    url: "lizeth-rocha-campos",
    formacion: "AAutonomous University of Baja California Valle de las Palmas",
    horario: "Monday to Thursday: 8:00 AM - 5:00 PM",
    bio: "Dental surgeon with experience in orthodontic and cosmetic dental treatments. Committed to oral health and patient well-being.",
  },
  {
    id: "DraItzel",
    nombre: "Dr. Alejandra Yazmin Gonzalez Amezquita",
    imagen: "/images/alejandra.webp",
    titulo: "Dental Surgeon",
    cedula: "12030675",
    url: "alejandra-yazmin-gonzalez-amezquita",
    especialista: "orthodontics specialist",
    formacionES: "INODET",
    experiencia: "4 years of experience",
    formacion: "Autonomous University of Baja California Otay",
    horario: "Wednesday to Sunday: 11:00 AM - 8:00 PM",
    bio: "Specialist in root canal treatments with cutting-edge technology. Focus on minimally invasive procedures for greater patient comfort.",
  },
];

const doctores = isEnglish ? doctores_en : doctores_es;
---

<section class="bg-white py-20 text-center" id="doctores">
  <h2
    class="text-gray-700 text-4xl mb-4 font-bold relative after:content-[''] after:block after:w-20 after:h-1 after:bg-reforma after:mx-auto after:mt-4"
  >
    {
      isEnglish
        ? "Meet our team of specialists and dentists"
        : "Conoce nuestro equipo de especialistas y dentistas"
    }
  </h2>
  <p class="text-gray-600 text-lg mb-12 max-w-2xl mx-auto leading-relaxed">
    {
      isEnglish
        ? "Doctors specialized in oral care and your overall health."
        : "Doctores y doctoras especialistas en el cuidado de tu boca y tu salud integral."
    }
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
    {
      doctores.map((doctor) => (
        <a
          title={isEnglish ? "Show profile" : "Ver perfil completo"}
          href={
            isEnglish ? `/en/doctores/${doctor.url}` : `/doctores/${doctor.url}`
          }
          class="bg-white rounded-lg overflow-hidden shadow-md transition-transform transform hover:-translate-y-1 hover:shadow-lg flex flex-col border border-gray-200"
          aria-label={isEnglish ? "Show profile" : "Ver perfil completo"}
        >
          <div class="relative">
            <img
              title="Doctor"
              transition:name={doctor.nombre}
              src={doctor.imagen}
              alt={doctor.nombre}
              class="w-full h-auto object-cover transition-transform duration-500 hover:scale-105"
            />
            <span class="absolute top-4 right-4 bg-reforma text-white px-3 py-1 rounded-full text-sm font-semibold">
              {doctor.titulo}
            </span>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <h3 class="text-gray-700 text-xl font-bold mb-2">
              {doctor.nombre}
            </h3>
            <p class="text-gray-700 font-semibold mb-4 text-base">
              {doctor.experiencia}
            </p>

            <div class="text-gray-700 mb-4 text-sm flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                class="w-4 h-4 text-reforma"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                />
              </svg>
              <span>{doctor.formacion}</span>
            </div>

            <div class="text-gray-700 mb-4 text-sm flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                class="w-4 h-4 text-reforma"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <span>{doctor.horario}</span>
            </div>

            <button class="mt-auto inline-block px-6 py-3 bg-reforma text-white rounded-md font-semibold text-center transition-colors hover:bg-reforma/80 w-full cursor-pointer">
              {isEnglish ? "View full profile" : "Ver perfil completo"}
            </button>
          </div>
        </a>
      ))
    }
  </div>
</section>
