---
const isEnglish = Astro.url.pathname.startsWith("/en/");
---

<!-- SDK de Facebook (solo una vez) -->
<div id="fb-root"></div>
<script
  async
  defer
  crossorigin="anonymous"
  src="https://connect.facebook.net/es_LA/sdk.js#xfbml=1&version=v22.0"
></script>

<section class="py-12 bg-[#f8fcec]" id="redes">
  <div class="max-w-[1200px] mx-auto px-6">
    <h2 class="text-center mb-2 text-[#2d3748] text-[2.25rem] font-bold">
      {isEnglish ? "Our Social Networks" : "Nuestra Redes Sociales"}
    </h2>
    <p
      class="text-center text-[#4a5568] mb-10 text-[1.1rem] max-w-[600px] mx-auto"
    >
      {
        isEnglish
          ? "Stay connected with our latest publications"
          : "Mantente conectado con nuestras últimas publicaciones"
      }
    </p>

    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(350px,1fr))] gap-8 justify-center"
    >
      <!-- Publicación 1 -->
      <div
        class="bg-white rounded-[12px] overflow-hidden shadow-md transition-transform border border-[#e2e8f0] flex flex-col hover:translate-y-[-5px] hover:shadow-lg"
      >
        <div
          class="fb-post w-full max-w-[750px] mx-auto flex-1 mb-[-5px]"
          data-href="https://www.facebook.com/photo/?fbid=1247108386878805&set=a.797094705213511"
          data-width="750"
          data-show-text="true"
        >
          <blockquote
            cite="https://es-la.facebook.com/DentistaReforma/posts/1247108403545470"
            class="fb-xfbml-parse-ignore"
          >
            <p>
              Meet Dr. Karen Perez, a disciplined, passionate, and bold
              endodontist. and teacher whose passion inspires and energizes...
            </p>
            Publicado por <a
              title="Facebook"
              href="https://www.facebook.com/DentistaReforma"
              aria-label="Facebook">Dental Reforma</a
            > en <a
              title="Facebook"
              href="https://es-la.facebook.com/DentistaReforma/posts/1247108403545470"
              aria-label="Facebook">Sábado, 8 de marzo de 2025</a
            >
          </blockquote>
        </div>
      </div>

      <!-- Publicación 2 -->
      <div
        class="bg-white rounded-[12px] overflow-hidden shadow-md transition-transform border border-[#e2e8f0] flex flex-col hover:translate-y-[-5px] hover:shadow-lg"
      >
        <div
          class="fb-post w-full max-w-[750px] mx-auto flex-1 mb-[-5px]"
          data-href="https://www.facebook.com/photo?fbid=1237807401142237&set=a.797094705213511"
          data-width="750"
          data-show-text="true"
        >
          <blockquote
            cite="https://es-la.facebook.com/DentistaReforma/posts/1237807417808902"
            class="fb-xfbml-parse-ignore"
          >
            <p>Hoy celebramos nuestro aniversario #9</p>
            Publicado por <a
              title="Facebook"
              href="https://www.facebook.com/DentistaReforma"
              aria-label="Facebook">Dental Reforma</a
            > en <a
              title="Facebook"
              href="https://es-la.facebook.com/DentistaReforma/posts/1237807417808902"
              aria-label="Facebook">Lunes, 24 de febrero de 2025</a
            >
          </blockquote>
        </div>
      </div>

      <!-- Publicación 3 -->
      <div
        class="bg-white rounded-[12px] overflow-hidden shadow-md transition-transform border border-[#e2e8f0] flex flex-col hover:translate-y-[-5px] hover:shadow-lg"
      >
        <div
          class="fb-post w-full max-w-[750px] mx-auto flex-1 mb-[-5px]"
          data-href="https://www.facebook.com/photo?fbid=1222013052721672&set=a.797094705213511"
          data-width="750"
          data-show-text="true"
        >
          <blockquote
            cite="https://es-la.facebook.com/DentistaReforma/posts/1222013079388336"
            class="fb-xfbml-parse-ignore"
          >
            <p>
              En San Valentín 💕queremos celebrar a lo grande y compartir
              contigo esta PROMOCIÓN💖❤️para que luzcas una bella...
            </p>
            Publicado por <a
              title="Facebook"
              href="https://www.facebook.com/DentistaReforma"
              aria-label="Facebook">Dental Reforma</a
            > en <a
              title="Facebook"
              href="https://es-la.facebook.com/DentistaReforma/posts/1222013079388336"
              aria-label="Facebook">Martes, 4 de febrero de 2025</a
            >
          </blockquote>
        </div>
      </div>
    </div>
  </div>
</section>
